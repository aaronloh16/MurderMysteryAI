# Murder Mystery AI. Every variable is optional.
# With nothing set, the game runs in demo mode: scripted suspects, no cost.

# --- Live AI suspects (text) -------------------------------------------------
# AI Gateway key from https://vercel.com/d?to=/[team]/~/ai-gateway/api-keys
# On Vercel you can skip this: the project's OIDC token (VERCEL_OIDC_TOKEN) is used automatically.
AI_GATEWAY_API_KEY=
# Any AI Gateway model id. Default: anthropic/claude-haiku-5.5
AI_MODEL=
# Set to true to force demo mode even when a key is present.
DISABLE_LIVE_AI=

# --- Live voice (speech to speech, beta) --------------------------------------
# Costs real money per minute, so it is opt-in. Requires live AI above.
ENABLE_VOICE=
# Hard cap on each voice call, in seconds. Default 120.
VOICE_SESSION_SECONDS=

# --- Abuse and cost guards ----------------------------------------------------
# Questions per suspect in live mode (then they "ask for a lawyer"). Default 20.
QUESTIONS_PER_SUSPECT=
# Live text requests per IP per 10 minutes. Default 40.
RATE_TEXT_PER_10M=
# Voice calls per IP per day. Default 6.
RATE_VOICE_PER_DAY=
# Global daily budgets. When spent, text falls back to scripts and voice turns off.
DAILY_TEXT_BUDGET=
DAILY_VOICE_BUDGET=

# Shared rate limits across serverless instances (recommended in production).
# The Vercel Marketplace Upstash integration injects KV_REST_API_URL / KV_REST_API_TOKEN, which also work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Canonical URL for metadata and the sitemap. Defaults to the Vercel production URL.
NEXT_PUBLIC_SITE_URL=
